#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10
#define U_MS_U &mmv MOVE_UP
#define U_MS_D &mmv MOVE_DOWN
#define U_MS_L &mmv MOVE_LEFT
#define U_MS_R &mmv MOVE_RIGHT
#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  //  600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

/ {
    behaviors {
        mmv {
            acceleration-exponent = <1>;      // 1
            time-to-max-speed-ms = <900>;    // 40
            delay-ms = <0>;                   // 0
        };

        msc {
            acceleration-exponent = <1>;      // 0
            time-to-max-speed-ms = <400>;      // 500
            delay-ms = <0>;                   //   10
        };
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp TILDE     &kp N1  &kp N2  &kp N3        &kp N4  &kp N5       &kp UP_ARROW     &kp N6     &kp N7  &kp N8     &kp N9   &kp N0    &none
&kp TAB       &kp Q   &kp W   &kp E         &kp R   &kp T        &kp DOWN_ARROW   &kp Y      &kp U   &kp I      &kp O    &kp P     &kp BACKSPACE
&kp CAPS      &kp A   &kp S   &kp D         &kp F   &kp G        &kp LEFT_ARROW   &kp H      &kp J   &kp K      &kp L    &kp SEMI  &kp APOS
&kp LSHFT     &kp Z   &kp X   &kp C         &kp V   &kp B        &kp RIGHT_ARROW  &kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp ESCAPE
&kp LEFT_ALT  &none   &none   &kp LEFT_GUI  &mo 1   &kp SPACE    &kp ENTER        &kp ENTER  &mo 2   &kp DEL    &none    &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "LAYER0";
        };

        layer_1 {
            bindings = <
&kp GRAVE  &kp F1           &kp F2            &kp F3    &kp F4  &kp F5       &none  &kp F6    &kp F7    &kp F8   &kp F9     &kp F10  &kp F11
&kp TAB    &kp N1           &kp N2            &kp N3    &kp N4  &kp N5       &none  &kp N6    &kp N7    &kp N8   &kp N9     &kp N0   &kp BSPC
&kp LCTRL  &none            &none             &none     &none   &kp LG(L)    &none  &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT  &none    &none
&kp LSHFT  &kp NON_US_HASH  &kp LC(LA(BSLH))  &none     &none   &none        &none  &none     &none     &none    &none      &none    &kp ESCAPE
&kp LALT   &none            &none             &kp LGUI  &mo 1   &kp SPACE    &none  &kp RET   &mo 2     &kp DEL  &none      &none
            >;

            sensor-bindings = <&inc_dec_kp K_REDO K_UNDO>;
        };

        layer_2 {
            bindings = <
&kp GRAVE     &none         &none            &none          &none         &none            &msc SCRL_UP     &none          &none         &none         &none         &none         &kp PRINTSCREEN
&kp TAB       &kp LS(EXCL)  &kp LS(DQT)      &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)    &msc SCRL_DOWN   &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)  &kp LS(LPAR)  &kp LS(RPAR)  &kp BSPC
&kp LCTRL     &none         &kp PRINTSCREEN  &none          &none         &none            &msc SCRL_LEFT   &kp MINUS      &kp EQUAL     &kp LBKT      &kp RBKT      &none         &none
&kp LSHFT     &none         &none            &none          &none         &none            &msc SCRL_RIGHT  &kp LS(UNDER)  &kp LS(PLUS)  &kp LS(LBRC)  &kp LS(RBRC)  &none         &kp ESC
&kp LEFT_ALT  &none         &none            &kp LGUI       &mo 1         &kp SPACE        &none            &kp RET        &mo 2         &kp DEL       &none         &none
            >;
        };
    };
};
